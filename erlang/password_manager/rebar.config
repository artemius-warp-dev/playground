{erl_opts, [debug_info]}.

{deps, [
    {burrito, "~> 1.0"}
]}.

{releases, [
    {passm, "0.1.0", [
        {applications, [passm, crypto, kernel, stdlib]}
    ]}
]}.

{burrito, [
    {targets, [
        {linux, [{os, linux}, {cpu, amd64}]}
    ]}
]}.

%% Entry point for escript (alternative lightweight build)
{escript_main_app, passm}.
{escript_name, passm}.
{escript_emu_args, "%%! -noshell -noinput\n"}.
